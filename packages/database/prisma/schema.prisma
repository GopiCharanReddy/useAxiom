datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  PROPOSED
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model Organization {
  id                 String                @id @default(uuid()) @db.Uuid
  name               String
  whatsappBusinessId String?               @map("whatsapp_business_id")
  createdAt          DateTime              @default(now()) @map("created_at")
  deletedAt          DateTime?             @map("deleted_at")
  users              User[]
  departments        Department[]
  projects           Project[]
  whatsappMessages   WhatsAppMessage[]
  auditLogs          AuditLog[]
  notificationTemplates NotificationTemplate[]
  notificationEvents    NotificationEvent[]
  notificationHistory   NotificationHistory[]
  reminderRules         ReminderRule[]

  @@map("organizations")
}


model User {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  departmentId   String?           @map("department_id") @db.Uuid
  role           Role
  name           String
  email          String?           @unique
  passwordHash   String?           @map("password_hash")
  phoneNumber    String            @map("phone_number")
  createdAt      DateTime          @default(now()) @map("created_at")
  deletedAt      DateTime?         @map("deleted_at")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projects       Project[]         @relation("ProjectManager")
  assignments    Assignment[]
  messages       WhatsAppMessage[]
  employeeId     String?           @unique @map("employee_id")
  projectMembers ProjectMember[]
  specialty      String?

  @@map("users")
}

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime     @default(now()) @map("created_at")
  deletedAt      DateTime?    @map("deleted_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]

  @@map("departments")
}

model Project {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  managerId      String?        @map("manager_id") @db.Uuid
  name           String
  objective      String
  status            ProjectStatus  @default(PLANNING)
  targetDeadline    DateTime?      @map("target_deadline")
  healthScore       Int?           @map("health_score")
  healthStatus      String?        @map("health_status")
  healthReasoning   String?        @map("health_reasoning")
  healthSuggestions Json?          @map("health_suggestions")
  createdAt         DateTime       @default(now()) @map("created_at")
  deletedAt      DateTime?      @map("deleted_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager        User?          @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  milestones     Milestone[]
  tasks          Task[]
  domain         String?
  techStack      String[]
  members        ProjectMember[]

  @@map("projects")
}

model Milestone {
  id             String       @id @default(uuid()) @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  name           String
  description    String?
  targetDeadline DateTime?    @map("target_deadline")
  createdAt      DateTime     @default(now()) @map("created_at")
  deletedAt      DateTime?    @map("deleted_at")
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@map("milestones")
}

model Task {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  milestoneId    String?          @map("milestone_id") @db.Uuid
  title          String
  description    String
  status         TaskStatus       @default(PROPOSED)
  estimatedHours Decimal?         @map("estimated_hours") @db.Decimal(5, 2)
  createdByAi    Boolean          @default(false) @map("created_by_ai")
  createdAt      DateTime         @default(now()) @map("created_at")
  deletedAt      DateTime?        @map("deleted_at")
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignments    Assignment[]
  dependencies   TaskDependency[] @relation("TaskPrerequisite")
  dependents     TaskDependency[] @relation("TaskDependent")

  @@map("tasks")
}

model TaskDependency {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  task            Task     @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskPrerequisite", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model Assignment {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("assignments")
}

model WhatsAppMessage {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  direction      MessageDirection
  metaMessageId  String?           @map("meta_message_id")
  content        String
  deliveryStatus MessageStatus     @default(SENT) @map("delivery_status")
  createdAt      DateTime          @default(now()) @map("created_at")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads        ConversationThread[]

  @@map("whatsapp_messages")
}

model ConversationThread {
  id        String          @id @default(uuid()) @db.Uuid
  messageId String          @map("message_id") @db.Uuid
  taskId    String?         @map("task_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  message   WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("conversation_threads")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String       @map("actor_id") @db.Uuid
  action         String
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  previousState  Json?        @map("previous_state")
  newState       Json?        @map("new_state")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model LongTermMemory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  content   String
  embedding Unsupported("vector(1536)")?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("long_term_memory")
}

model ShortTermMemory {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @map("thread_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("short_term_memory")
}

model ProjectMember {
  id                 String   @id @default(uuid()) @db.Uuid
  projectId          String   @map("project_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  assignedAt         DateTime @default(now()) @map("assigned_at")
  notificationStatus String?  @map("notification_status")
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ============================================================
// Communication Module
// ============================================================

enum NotificationEventType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ASSIGNED
  PROJECT_DEADLINE_CHANGED
  PROJECT_COMPLETED

  GOAL_CREATED
  GOAL_UPDATED
  GOAL_COMPLETED
  GOAL_DEADLINE_CHANGED

  TASK_CREATED
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_UPDATED
  TASK_PRIORITY_CHANGED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_OVERDUE

  EMPLOYEE_ADDED
  EMPLOYEE_REMOVED

  MANUAL_NOTIFICATION
  DAILY_SUMMARY
  WEEKLY_SUMMARY
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
  IN_APP
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RETRYING
  CANCELLED
  SKIPPED
}

/// Reusable message templates with {{placeholder}} support
model NotificationTemplate {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  name           String
  description    String?
  eventType      NotificationEventType @map("event_type")
  channel        NotificationChannel   @default(WHATSAPP)
  subject        String?               /// Used for email channel
  body           String                /// Supports {{employeeName}}, {{projectName}}, etc.
  isActive       Boolean               @default(true) @map("is_active")
  isDefault      Boolean               @default(false) @map("is_default")
  category       String?
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  history        NotificationHistory[]
  reminderRules  ReminderRule[]

  @@map("notification_templates")
}

/// Immutable audit log of every business event that triggered notifications
model NotificationEvent {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  eventType      NotificationEventType @map("event_type")
  entityType     String                @map("entity_type") /// "project" | "task" | "milestone"
  entityId       String                @map("entity_id") @db.Uuid
  actorId        String                @map("actor_id") @db.Uuid /// user who triggered the event
  payload        Json                  /// raw variables for template rendering
  createdAt      DateTime              @default(now()) @map("created_at")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  history        NotificationHistory[]

  @@map("notification_events")
}

/// Delivery record for each notification sent
model NotificationHistory {
  id              String                     @id @default(uuid()) @db.Uuid
  organizationId  String                     @map("organization_id") @db.Uuid
  eventId         String                     @map("event_id") @db.Uuid
  templateId      String?                    @map("template_id") @db.Uuid
  recipientUserId String?                    @map("recipient_user_id") @db.Uuid
  recipientPhone  String?                    @map("recipient_phone")
  recipientEmail  String?                    @map("recipient_email")
  recipientName   String?                    @map("recipient_name")
  channel         NotificationChannel
  renderedSubject String?                    @map("rendered_subject")
  renderedBody    String                     @map("rendered_body")
  deliveryStatus  NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  errorMessage    String?                    @map("error_message")
  metaMessageId   String?                    @map("meta_message_id")
  retryCount      Int                        @default(0) @map("retry_count")
  requestTime     DateTime?                  @map("request_time")
  responseTime    DateTime?                  @map("response_time")
  apiResponse     Json?                      @map("api_response")
  sentAt               DateTime?                  @map("sent_at")
  deliveredAt          DateTime?                  @map("delivered_at")
  queuedAt             DateTime?                  @map("queued_at")
  processingAt         DateTime?                  @map("processing_at")
  readAt               DateTime?                  @map("read_at")
  failedAt             DateTime?                  @map("failed_at")
  lastRetryAt          DateTime?                  @map("last_retry_at")
  completedAt          DateTime?                  @map("completed_at")
  deliveryLatencyMs    Int?                       @map("delivery_latency_ms")
  processingDurationMs Int?                       @map("processing_duration_ms")
  correlationId        String?                    @map("correlation_id")
  failureCategory      String?                    @map("failure_category")
  isDeadLetter         Boolean                    @default(false) @map("is_dead_letter")
  deadLetterReason     String?                    @map("dead_letter_reason")
  webhookLogs          Json?                      @map("webhook_logs")
  createdAt            DateTime                   @default(now()) @map("created_at")
  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event                NotificationEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template             NotificationTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@map("notification_history")
}

/// Rules that control when/how notifications are sent for specific event types
model ReminderRule {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  name           String
  description    String?
  eventType      NotificationEventType @map("event_type")
  channel        NotificationChannel   @default(WHATSAPP)
  templateId     String?               @map("template_id") @db.Uuid
  isActive       Boolean               @default(true) @map("is_active")
  delayMinutes   Int                   @default(0) @map("delay_minutes")
  conditions     Json?                 /// optional filter conditions (e.g., { "priority": "HIGH" })
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@map("reminder_rules")
}

